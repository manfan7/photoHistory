{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "photoHistory",
  "version": "1.0.0",
  "identifier": "com.manfan7.photohistory",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Фотоархив — liquid glass",
        "width": 1280,
        "height": 860,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#070a14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png"
    ]
  }
}
